APP_NAME=ZoneCast
SECRET_KEY=replace-with-a-long-random-string

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin

DATABASE_URL=sqlite:///./data/zonecast.db

GLOBAL_ALL_CALL_ADDRESS=239.1.1.99
GLOBAL_ALL_CALL_PORT=5004

RTP_PAYLOAD_TYPE=0
RTP_PACKET_MS=20
RTP_MULTICAST_TTL=8

TIMEZONE=Europe/Rome
MAX_UPLOAD_MB=50
MAX_DURATION_SECONDS=600

# Porta di ascolto del server. Sotto 1024 (es. 80) serve la capability
# CAP_NET_BIND_SERVICE, già concessa sia nel Dockerfile/docker-compose.yml
# sia in deploy/zonecast.service.
APP_PORT=8000
